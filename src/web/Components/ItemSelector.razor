@typeparam TItem where TItem : class
@typeparam TKey

<RadzenStack Gap="0.75rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenDropDown TValue="TKey" @bind-Value="selectedKey" Data="AvailableItems" TextProperty="@TextProperty" ValueProperty="@ValueProperty" Placeholder="@Placeholder" Style="@(ShowQuantity ? "width:60%" : "width:75%")">
            <Template Context="item">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText Text="@ItemText(item)" />
                    @if (ShowQuantity && StockSelector is not null)
                    {
                        <RadzenText Text="@(HasStock(item) ? $"{StockSelector(item)} available" : "Out of stock")" TextStyle="TextStyle.Caption" />
                    }
                </RadzenStack>
            </Template>
        </RadzenDropDown>

        @if (ShowQuantity)
        {
            <RadzenNumeric TValue="int" @bind-Value="quantityToAdd" Min="1" Max="@(Math.Max(1, SelectedItem is null ? 1 : StockSelector?.Invoke(SelectedItem) ?? int.MaxValue))" Name="ItemQuantity" Style="width:8rem" />
        }
        <RadzenButton Text="Add" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="AddItem" Disabled="!CanAddItem" />
    </RadzenStack>

    @if (ShowQuantity && SelectedItem is not null && !HasStock(SelectedItem))
    {
        <RadzenText Text="This item is out of stock." Style="color: var(--rz-danger);" />
    }

    <RadzenStack Gap="0.5rem">
        <RadzenText Text="Added items" TextStyle="TextStyle.Subtitle2" />
        @if (SelectedItems.Count == 0)
        {
            <RadzenText Text="No items added yet." TextStyle="TextStyle.Caption" />
        }
        @foreach (var item in SelectedItems)
        {
            <RadzenCard>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Normal" AlignItems="AlignItems.Center">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => RemoveItem(ItemKeySelector(item)))" />
                    <RadzenStack Gap="0.15rem">
                        <RadzenText Text="@ItemText(item)" TextStyle="TextStyle.Body1" />
                        @if (ShowQuantity)
                        {
                            <RadzenText Text="@($"Quantity: {StockSelector?.Invoke(item) ?? 0}")" TextStyle="TextStyle.Caption" />
                        }
                    </RadzenStack>
                    
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public IList<TItem> SelectedItems { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, TKey> ItemKeySelector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> ItemText { get; set; } = default!;
    [Parameter, EditorRequired] public string TextProperty { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ValueProperty { get; set; } = string.Empty;
    [Parameter] public Func<TItem, int?> StockSelector { get; set; }
    [Parameter] public Func<TItem, int, TItem> CreateSelectedItem { get; set; }
    [Parameter] public bool ShowQuantity { get; set; }
    [Parameter] public bool KeepSelectedItemsInDropdown { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select an item";
    [Parameter] public EventCallback<IList<TItem>> SelectedItemsChanged { get; set; }

    private TKey selectedKey = default!;
    private int quantityToAdd = 1;

    private IEnumerable<TItem> AvailableItems => KeepSelectedItemsInDropdown
        ? Items
        : Items.Where(item => SelectedItems.All(selected => !EqualityComparer<TKey>.Default.Equals(ItemKeySelector(selected), ItemKeySelector(item))));

    private TItem SelectedItem
    {
        get
        {
            return Items.FirstOrDefault(item => EqualityComparer<TKey>.Default.Equals(ItemKeySelector(item), selectedKey));
        }
    }

    private bool CanAddItem => SelectedItem is not null
    && (!ShowQuantity || (HasStock(SelectedItem) && quantityToAdd > 0 && quantityToAdd <= StockSelector!(SelectedItem)!.Value));

    private bool HasStock(TItem item) => StockSelector?.Invoke(item) is not int stock || stock > 0;

    private async Task AddItem()
    {
        if (!CanAddItem || SelectedItem is null)
        {
            return;
        }

        var updatedItems = SelectedItems.ToList();
        updatedItems.Add(CreateSelectedItem?.Invoke(SelectedItem, quantityToAdd) ?? SelectedItem);
        await UpdateSelectedItems(updatedItems);
        selectedKey = default!;
        quantityToAdd = 1;
    }

    private async Task RemoveItem(TKey key)
    {
        var updatedItems = SelectedItems.ToList();
        var itemIndex = updatedItems.FindIndex(item =>
            EqualityComparer<TKey>.Default.Equals(ItemKeySelector(item), key));

        if (itemIndex < 0)
        {
            return;
        }

        updatedItems.RemoveAt(itemIndex);
        await UpdateSelectedItems(updatedItems);
    }

    private async Task UpdateSelectedItems(IList<TItem> updatedItems)
    {
        SelectedItems = updatedItems;
        await SelectedItemsChanged.InvokeAsync(updatedItems);
    }
}
